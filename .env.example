# Database
DATABASE_URL=sqlite+aiosqlite:///./screener.db

# AI Models (Groq)
GROQ_API_KEY=your_groq_api_key_here
CONVERSATION_MODEL=openai/gpt-oss-120b
ASSESSMENT_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3-turbo

# Authentication (JWT)
SECRET_KEY=generate_a_random_64_char_string_here_use_openssl_rand_hex_32
JWT_LIFETIME_SECONDS=86400

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Monitoring (optional)
SENTRY_DSN=
